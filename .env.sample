# 테이블오더 환경 변수 샘플
#
# 사용법: 이 파일을 .env로 복사해 값을 채운 뒤, 아래처럼 실행한다.
#   cp .env.sample .env
#   python -m uvicorn app.main:app --env-file .env --port 8000
#
# 두 값 모두 선택 사항이며 기본값이 있어 비워 두면 로컬 데모 기본값으로 동작한다.
# 운영 환경에서는 최소한 TABLE_ORDER_JWT_SECRET를 반드시 교체한다.

# 로그인 토큰(JWT) 서명 키. 32바이트 이상 무작위 문자열 권장.
# 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TABLE_ORDER_JWT_SECRET=

# 데이터베이스 접속 URL. 기본은 실행 폴더의 SQLite 파일.
# 예: sqlite:////var/data/table_order.db
TABLE_ORDER_DATABASE_URL=sqlite:///table_order.db
